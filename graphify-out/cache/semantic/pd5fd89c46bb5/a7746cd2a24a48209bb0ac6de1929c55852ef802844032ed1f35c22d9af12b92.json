{"nodes": [{"id": "docs_trd_document", "label": "SURGE Technical Requirements (TRD)", "file_type": "document", "source_file": "docs/TRD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_system_architecture", "label": "Three-Tier System Architecture", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The split keeps authentication, transactions and project ownership in Java, and scientific types/solvers in Python \u2014 neither runtime has to grow the other's competency."}, {"id": "docs_trd_web_gis_frontend", "label": "Web GIS Frontend (/web-map)", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_java_backend_api", "label": "Java Spring Boot Backend API", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_python_optimisation_engine", "label": "Python Optimisation Engine", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_postgis", "label": "PostGIS Spatial Store", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_fastapi", "label": "FastAPI", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_pandapower", "label": "pandapower Electrical Analysis", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_geopandas", "label": "GeoPandas Vector GIS", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_networkx_custom_astar", "label": "NetworkX + Custom A* Routing", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_scikit_learn", "label": "scikit-learn ML Ranking", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_candidate_feature_set", "label": "Candidate Feature Set for Scoring/ML", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gradient boosting or random forest is the first model choice; where labeled historical data is insufficient the deterministic score stays official and ML output is never silently substituted."}, {"id": "docs_trd_current_pipeline", "label": "Current Implemented Pipeline", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 5.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_target_full_pipeline", "label": "Target Full Pipeline", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 5.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_post_api_v1_optimise", "label": "POST /api/v1/optimise Contract", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 6.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_feeder_identity_contract_gap", "label": "Feeder-Identity Contract Gap", "file_type": "rationale", "source_file": "docs/TRD.md", "source_location": "sections 6.3, 11.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python's feeder_id does not match the feeder-name keys Java's RouteService expects, so Java invents its own names and persists every edge as a separate route record; until both services agree whether a Feature is an edge, a segment, or a whole feeder, route persistence is untrustworthy."}, {"id": "docs_trd_route_service", "label": "Java RouteService", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 6.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_utm_projection", "label": "Unified UTM Projection Boundary", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "sections 2.2, 5.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python converts geographic coordinates into a single metric UTM CRS before graph/grouping calculations so distances and costs are metric and comparable."}, {"id": "docs_trd_wtg_grouping_kmeans_milp", "label": "K-Means-Assisted MILP Feeder Grouping", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_topology_mst", "label": "Per-Feeder MST Topology", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_mst_euclidean_limitation", "label": "Euclidean MST Limitation", "file_type": "rationale", "source_file": "docs/TRD.md", "source_location": "sections 5.2, 11.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MST minimizes straight-line topology length only; it ignores terrain, exclusions, parcels, access, junctions, shared trunks and electrical performance, so it understates real corridor length and cannot enforce hard routing constraints."}, {"id": "docs_trd_cost_surface_standalone", "label": "Cost Surface Not Wired Into Pipeline", "file_type": "rationale", "source_file": "docs/TRD.md", "source_location": "sections 5.1, 11.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SURGE-PY-007's uniform raster + affine transform exists standalone; zero-padding boundary behavior is untested and can place points one index outside the raster array."}, {"id": "docs_trd_electrical_analysis_placeholder", "label": "electrical_analysis.py Placeholder", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Until load flow, voltage drop and losses land, scenario differentiation and hard-constraint rejection are not possible."}, {"id": "docs_trd_cost_function_placeholder", "label": "cost_function.py Placeholder", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_statelessness", "label": "Stateless Python Computation Boundary", "file_type": "rationale", "source_file": "docs/TRD.md", "source_location": "section 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Python service holds no persistence responsibility, keeping all transactional state and ownership in Java."}, {"id": "docs_trd_golden_demonstration_dataset", "label": "Golden Demonstration Dataset", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small controlled dataset (8-12 WTGs, exclusions, crossings, DEM) is the acceptance basis: the system must produce at least two feeders, avoid hard exclusions, show different winners across the four scenarios, and reject at least one electrically invalid candidate."}, {"id": "docs_trd_ci_quality_gates", "label": "CI Quality Gates", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_trd_determinism_sorted_edges", "label": "Normalized and Sorted Edge Selection", "file_type": "rationale", "source_file": "docs/TRD.md", "source_location": "section 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selected edges/topologies are normalized and sorted so output is byte-stable across runs, which is what makes the determinism requirement testable."}, {"id": "docs_trd_topology_validation_rules", "label": "Topology Construction Validation Rules", "file_type": "concept", "source_file": "docs/TRD.md", "source_location": "section 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejects zero/multiple substations, feeder-count mismatch, duplicate assignments, missing assigned nodes, incomplete coverage and disconnected results \u2014 structural invalidity is caught before any downstream cost or electrical work."}, {"id": "docs_trd_branching_policy", "label": "One-Issue-Per-Branch Agent Policy", "file_type": "rationale", "source_file": "docs/TRD.md", "source_location": "section 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One code-changing agent per branch, never on main/develop, all merges human-reviewed; secrets and private GIS data stay outside AI-assisted prompts and tooling."}], "edges": [{"source": "docs_trd_document", "target": "docs_prd_surge", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "so