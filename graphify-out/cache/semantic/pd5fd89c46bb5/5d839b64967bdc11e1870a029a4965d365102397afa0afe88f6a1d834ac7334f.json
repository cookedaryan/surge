{"nodes": [{"id": "docs_app_flow_document", "label": "SURGE Application Flow (APP-FLOW)", "file_type": "document", "source_file": "docs/APP-FLOW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_app_flow_high_level_journey", "label": "High-Level User Journey", "file_type": "concept", "source_file": "docs/APP-FLOW.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_app_flow_screen_1_project_setup", "label": "Screen 1 \u2014 Project Setup", "file_type": "concept", "source_file": "docs/APP-FLOW.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_app_flow_screen_2_gis_layers", "label": "Screen 2 \u2014 GIS Layers", "file_type": "concept", "source_file": "docs/APP-FLOW.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layers not yet consumed by the pipeline (e.g. DEM terrain cost) are still accepted and stored today \u2014 a known, documented implementation gap rather than silent data loss."}, {"id": "docs_app_flow_screen_3_optimisation_settings", "label": "Screen 3 \u2014 Optimisation Settings", "file_type": "concept", "source_file": "docs/APP-FLOW.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_app_flow_screen_4_network_results", "label": "Screen 4 \u2014 Network Results (Map)", "file_type": "concept", "source_file": "docs/APP-FLOW.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_app_flow_screen_5_scenario_comparison", "label": "Screen 5 \u2014 Scenario Comparison", "file_type": "concept", "source_file": "docs/APP-FLOW.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The comparison table's shape is the contract the backend is being built toward, not a claim that every cell is populated today; unimplemented rows must show placeholders rather than fabricated numbers."}, {"id": "docs_app_flow_screen_6_reports", "label": "Screen 6 \u2014 Reports", "file_type": "concept", "source_file": "docs/APP-FLOW.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exports must carry the same preliminary/planned labeling as the screens they derive from so downstream land and regulatory consumers never mistake MVP output for final engineering data."}, {"id": "docs_app_flow_data_provenance_flow", "label": "Data Provenance Through the Flow", "file_type": "concept", "source_file": "docs/APP-FLOW.md", "source_location": "section 4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser and Java stay in WGS84 end to end; only Python projects to UTM for computation and projects back before responding, so a single CRS boundary exists rather than many."}, {"id": "docs_app_flow_explainability_touchpoint", "label": "Explainability Touchpoint", "file_type": "rationale", "source_file": "docs/APP-FLOW.md", "source_location": "section 4.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every screen from 4 onward must answer 'why this result?'; an ML-derived score must never be shown without an experimental label unless the deterministic score is shown alongside it."}, {"id": "docs_app_flow_demo_data_fallback", "label": "Demo-Data Fallback Behavior", "file_type": "rationale", "source_file": "docs/APP-FLOW.md", "source_location": "section 4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demo fallbacks on failed API calls are acceptable for early development but must be visibly labeled before any user-facing release, so a failure is never read as a result."}, {"id": "docs_app_flow_sync_vs_async_optimisation", "label": "Synchronous vs Asynchronous Optimisation", "file_type": "rationale", "source_file": "docs/APP-FLOW.md", "source_location": "section 4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Today Java blocks on Python's response; once the full pipeline (routing + poles + ROW + electrical + ranking) lands, run times force async job submission with polling, turning Screen 4's blocking spinner into a job-status view."}, {"id": "docs_app_flow_flow_to_component_traceability", "label": "Flow-to-Component Traceability Matrix", "file_type": "concept", "source_file": "docs/APP-FLOW.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_app_flow_preliminary_topology_indicator", "label": "Preliminary Topology Indicator", "file_type": "rationale", "source_file": "docs/APP-FLOW.md", "source_location": "section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screen 4 needs a visible 'preliminary topology only' marker until terrain-aware A* routing replaces the Euclidean MST, so users do not read straight-edge topology as a routed corridor."}], "edges": [{"source": "docs_app_flow_document", "target": "docs_prd_surge", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/APP-FLOW.md", "source_location": "companion documents", "weight": 1.0}, {"source": "docs_app_flow_document", "target": "docs_trd_document", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/APP-FLOW.md", "source_location": "companion documents", "weight": 1.0}, {"source": "docs_app_flow_document", "target": "docs_app_flow_high_level_journey", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/APP-FLOW.md", "source_locat