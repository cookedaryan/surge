{"nodes": [{"id": "docs_artifacts_whats_next", "label": "Sunday KMZ-to-33 kV Network Delivery Plan", "file_type": "document", "source_file": "docs/artifacts/whats-next.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_artifacts_whats_next_sunday_outcome_path", "label": "KMZ-to-Map Sunday Product Path", "file_type": "concept", "source_file": "docs/artifacts/whats-next.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Best' is defined narrowly as the highest-ranked electrically valid candidate among bounded generated candidates under disclosed weights - explicitly not a global optimum, a construction-approved design, or validation against data absent from the upload."}, {"id": "docs_artifacts_whats_next_hard_vs_soft_constraint_semantics", "label": "Hard Exclusion vs Soft Penalty Semantics", "file_type": "rationale", "source_file": "docs/artifacts/whats-next.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restricted land and confirmed no-go areas are hard exclusions; roads, HT lines and watercourses are soft buffered crossing penalties because blocking a connected road network can make every route impossible, and parcels are soft because an overhead route necessarily occupies land. Crossings and affected parcels must be disclosed, never hidden."}, {"id": "docs_artifacts_whats_next_spatial_constraints_geojson_contract", "label": "spatial_constraints_geojson Request Contract", "file_type": "concept", "source_file": "docs/artifacts/whats-next.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One explicit collection carrying constraint_id, constraint_type, routing_mode, buffer_m, cost_multiplier and source; avoidance_geojson may remain as an additive alias but its blanket hard-block semantics must not be applied to ordinary roads and parcels. Feature ordering must not affect the raster or result."}, {"id": "docs_artifacts_whats_next_preliminary_pole_class_claim", "label": "Preliminary Geometry-Based Pole Classes", "file_type": "rationale", "source_file": "docs/artifacts/whats-next.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Terminal/dead-end, angle/tension and tangent/suspension classes are derived from geometry alone and must be labeled preliminary in API properties, UI legend and narration, because conductor mechanical loads, wind zone, terrain, geotechnical data, crossing structures, foundations and statutory clearances are unavailable."}, {"id": "docs_artifacts_whats_next_keep_kmz_parsing_in_java", "label": "Keep KMZ Parsing in Java", "file_type": "rationale", "source_file": "docs/artifacts/whats-next.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Java already owns multipart upload, KMZ/KML extraction, preview, classification, overrides and persistence, so adding a second parser to Python would duplicate a working boundary; Python should keep receiving reviewed explicit GeoJSON domain inputs."}, {"id": "docs_artifacts_whats_next_java_transport_gap", "label": "Missing Java Constraint and Pole Transport", "file_type": "concept", "source_file": "docs/artifacts/whats-next.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Java job dispatch never queries persisted reference lines, parcels or restricted areas, sends no constraint GeoJSON or pole configuration, and RouteService.saveRoutesFromGeoJson skips every non-LineString so pole Points are discarded - the shortest critical path is transport and rendering, not a new optimiser."}, {"id": "docs_artifacts_whats_next_no_simulated_success", "label": "Failure Must Never Appear as Simulated Success", "file_type": "rationale", "source_file": "docs/artifacts/whats-next.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Python outage or impossible route must appear as failure and never fall back to a demo route displayed as success; a constraint that closes every path returns an explicit no-route failure rather than silently ignoring the policy."}], "edges": [{"source": "docs_artifacts_whats_next_keep_kmz_parsing_in_java", "target": "docs_artifacts_surge_jv_006_kmz_asset_classification_plan_kmz_geojson_converter", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/whats-next.md", "source_location": "\u00a74.1 Keep KMZ parsing in Java", "weight": 1.0}, {"source": "docs_artifacts_whats_next", "target": "docs_artifacts_surge_jv_006_kmz_asset_classification_plan_asset_classifier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/whats-next.md", "source_location": "\u00a73.1 Already implemented and reusable", "weight": 1.0}, {"source": "docs_artifacts_whats_next", "target": "docs_artifacts_whats_next_sunday_outcome_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/whats-next.md", "source_location": "\u00a71 The Sunday outcome", "weight": 1.0}, {"source": "docs_artifacts_whats_next_hard_vs_soft_constraint_semantics", "target": "docs_artifacts_whats_next_spatial_constraints_geojson_contract", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/whats-next.md", "source_location": "\u00a72.2 and \u00a74.2", "weight": 1.0}, {"source": "docs_artifacts_whats_next_spatial_constraints_geojson_contract", "target": "docs_artifacts_python_engine_architecture_cost_surface", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1