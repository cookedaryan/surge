{"nodes": [{"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_implementation_plan", "label": "Web Map Frontend Redesign Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_web_map_next", "label": "web-map-next Application", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Goal / Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vite + React 18 + TypeScript app scaffolded alongside web-map: server state through TanStack Query hooks over a typed API client, small client-only UI state in two Zustand stores, Leaflet kept vanilla, UI from six Radix-based primitives styled with Tailwind bound to the CSS-variable tokens."}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_global_constraints", "label": "Migration Global Constraints", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Global Constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design tokens, type roles and the 52px/50px/300px layout shape come from the approved mockup and must not drift without a design conversation; every code-changing step ends with npm run typecheck passing before commit."}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_no_backend_changes", "label": "No Backend or Database Changes", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Global Constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "backend-java, optimisation-python and database are untouched and the same REST/JWT contract holds throughout, so the redesign carries no cross-service risk."}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_jwt_localstorage_key", "label": "surge_jwt_token localStorage Key", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Global Constraints, Task 3, Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The JWT key is deliberately not renamed so no user is forced to re-login at cutover."}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_dark_theme_only", "label": "Dark Theme Only This Pass", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Global Constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Token structure must support a later light toggle without rework, but no toggle UI is built now \u2014 scope control, not a technical limit."}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_ui_primitives", "label": "Radix-Based UI Primitives", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Task 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Button, Card, Dialog, Select, Slider and Switch are the only styled primitives every feature component imports, so visual drift has a single choke point."}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_ui_store", "label": "useUiStore (Zustand UI State)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_auth_store", "label": "useAuthStore (Zustand Auth State)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_typed_api_client", "label": "Typed API Client (lib/api)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A behavior-preserving port of web-map/src/api.js split into typed modules by resource with unchanged method signatures, so Query hooks can call api.method(...) exactly as the old app.js did; per-resource fallbacks (empty GeoJSON, empty arrays, synthetic project) are preserved deliberately."}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_classify_ts", "label": "classify.ts Port", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copied byte-for-byte from classify.js with only six function signatures annotated \u2014 no rule, regex or ordering may change, and a manual parity check compares both implementations' output before commit."}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_asset_classifier_java", "label": "com.power.surge.service.classification.AssetClassifier", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Global Constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_query_hooks", "label": "TanStack Query Hooks (lib/query)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_map_canvas", "label": "MapCanvas Component", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Tasks 8, 10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_app_shell", "label": "App Shell (TopBar, RailNav, SidePanel, MapArea)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Task 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_scenario_comparison_modal", "label": "Scenario Comparison Modal", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Task 19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_vite_api_dev_proxy", "label": "Vite /api Dev Proxy", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesign.md", "source_location": "Task 1 Step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proxies /api to the Spring Boot backend on port 8080 in development, mirroring what nginx.conf does in production so the client code needs no environment branching."}, {"id": "docs_superpowers_plans_2026_08_12_web_map_frontend_redesign_cutover", "label": "Cutover (Docker, CI, README)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-12-web-map-frontend-redesig