# SURGE System Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=surgedb
DB_USER=postgres
DB_PASSWORD=postgres

# Spring Boot Java Backend
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Signing key for session tokens. Required — the backend refuses to start without it and
# docker compose refuses to interpolate, because the value this used to fall back to was a
# constant in a public repository and anyone holding it can mint an administrator token.
# Generate a fresh one per environment and never commit it:
#   openssl rand -base64 48
APP_JWT_SECRET=replace-me-with-at-least-32-random-bytes

# Python Optimization Engine Microservice
PYTHON_ENGINE_URL=http://localhost:8000
