{"nodes": [{"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_document", "label": "Web Map Frontend Redesign Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_technical_dashboard_design_system", "label": "Technical Dashboard Design System", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "sections 1, 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neutral near-black surfaces, hairline borders instead of blur/glow, one restrained accent, tighter data-dense typography \u2014 an engineering tool should read as precise rather than decorative."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_design_tokens", "label": "CSS Custom Property Design Tokens", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both dark and light palettes are expressed as custom properties so a theme toggle can be added later without rework, even though dark ships as the only theme in this pass."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_glassmorphism_problem", "label": "Glassmorphism Theme Problem", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Navy backgrounds, blur, glow shadows, two competing typefaces and multiple loud accents read as decorative for a data-dense engineering tool; the fixed 380px sidebar also ignores actual content density."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_monolithic_app_js_problem", "label": "Monolithic app.js Problem", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One 1000-line app.js, one 1450-line index.css and a 519-line index.html with every modal inlined leave no component boundaries \u2014 hard to navigate and unsafe to change."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_surge_map_engine", "label": "SurgeMapEngine", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_leaflet_stays_vanilla", "label": "Leaflet Stays Vanilla, Wrapped Not Ported", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SurgeMapEngine's 534 lines of bespoke drawing, routing-line and edit-mode logic would be high-risk to re-express declaratively in react-leaflet, so it is kept as-is behind one MapCanvas component owning a ref and useEffect lifecycle."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_tanstack_query_server_state", "label": "TanStack Query for Server State", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "sections 2, 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces hand-rolled fetchJson calls and manual setInterval polling, giving caching, retries and loading/error state once per hook instead of manual .hidden class toggling per component."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_zustand_client_state", "label": "Zustand for Client-Only UI State", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "sections 2, 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids prop-drilling between map and sidebar without pulling in Redux; client UI state is never mixed into the Query cache."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_feature_folder_architecture", "label": "Feature-Folder Architecture", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Folder boundaries map 1:1 onto the current sidebar tabs plus map and modals, giving a direct old-file to new-folder migration mapping so no feature's logic is spread across unrelated files."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_classify_js_unchanged", "label": "classify.js Imported Unchanged", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asset-classification rules must mirror the Java backend's AssetClassificationRules; the logic is framework-agnostic, not UI, so the redesign imports it untouched to prevent divergence."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_asset_classification_rules", "label": "Java AssetClassificationRules", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_manual_qa_only", "label": "Manual QA Only Verification", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This is a UI/architecture migration of existing behavior, not new business logic, and the current app has no test suite to extend \u2014 so parity is checked by hand, side by side, with CSV/PDF compared byte-for-byte where feasible."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_migration_plan", "label": "Build-Alongside Migration Plan", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "web-map-next is built as a sibling so web-map keeps running and deploying unchanged until cutover, avoiding any partially-broken intermediate state."}, {"id": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_tabular_nums_typography", "label": "Monospace Tabular Numerals for Readouts", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Numeric engineering readouts (MW, kV, km, $, counts) use a monospace face with font-variant-numeric: tabular-nums to reinforce the instrument-panel feel and keep columns aligned; fonts are self-hosted rather than CDN-loaded to avoid FOUT."}], "edges": [{"source": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_document", "target": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_technical_dashboard_design_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "sections 1, 3", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_glassmorphism_problem", "target": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_technical_dashboard_design_system", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 1", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_monolithic_app_js_problem", "target": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_feature_folder_architecture", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "sections 1, 4", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_technical_dashboard_design_system", "target": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_design_tokens", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-12-web-map-frontend-redesign-design.md", "source_location": "section 3", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_tabular_nums_typography", "target": "docs_superpowers_specs_2026_08_12_web_map_frontend_redesign_design_technical_dashboard_design_system", "relation": "rationale_for", "confidence": "EXTRACTED", "confidenc