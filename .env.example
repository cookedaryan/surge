# SURGE System Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=surgedb
DB_USER=postgres
DB_PASSWORD=postgres

# Spring Boot Java Backend
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Signing key for session tokens. Required — the backend refuses to start without it and
# docker compose refuses to interpolate, because the value this used to fall back to was a
# constant in a public repository and anyone holding it can mint an administrator token.
# Generate a fresh one per environment and never commit it:
#   openssl rand -base64 48
APP_JWT_SECRET=replace-me-with-at-least-32-random-bytes

# Credentials for the single administrator created on a FRESH database. Required only then —
# an existing database already has the account and ignores these. The password used to default
# to "admin", which is how an instance reached the internet with administrator access, so
# seeding now refuses rather than falling back. Minimum 8 characters, and not "admin".
SURGE_BOOTSTRAP_ADMIN_USERNAME=admin
SURGE_BOOTSTRAP_ADMIN_EMAIL=admin@surge.energy
SURGE_BOOTSTRAP_ADMIN_PASSWORD=

# Python Optimization Engine Microservice
PYTHON_ENGINE_URL=http://localhost:8000
