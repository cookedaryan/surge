{"nodes": [{"id": "docs_artifacts_python_engine_architecture", "label": "Python Engine Architecture and GIS Processing", "file_type": "document", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_artifacts_python_engine_architecture_optimisation_pipeline", "label": "Stateless FastAPI Optimisation Pipeline", "file_type": "concept", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python is a stateless computation boundary: Java keeps authentication, transactions and ownership while Python holds scientific types and solvers, so the scientific stack can evolve without touching persistence."}, {"id": "docs_artifacts_python_engine_architecture_py_006", "label": "SURGE-PY-006 Per-Feeder Minimum Spanning Tree", "file_type": "concept", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grouping decides feeder membership and MST decides connections inside a feeder; edges are normalized and sorted for deterministic output. Straight-line UTM distances mean the MST minimizes preliminary Euclidean length only, with terrain-aware routing deferred."}, {"id": "docs_artifacts_python_engine_architecture_py_007", "label": "SURGE-PY-007 Uniform Cost Surface", "file_type": "concept", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A padded north-up float32 raster filled with base cost 1.0 means routes optimize for distance until real layers are rasterized; positive infinity is reserved for hard exclusions and larger finite values for soft penalties. Known gaps: no padding validation, no bounds enforcement, no allocation cap."}, {"id": "docs_artifacts_python_engine_architecture_cost_surface", "label": "CostSurface Abstraction", "file_type": "concept", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_artifacts_python_engine_architecture_py_008", "label": "SURGE-PY-008 A* Physical Routing", "file_type": "concept", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_artifacts_python_engine_architecture_py_009", "label": "SURGE-PY-009 Route Geometry Refinement", "file_type": "concept", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shortcuts compare candidate and replaced-subpath cost with the same continuous integration model used by A*, so refinement can never undo A*'s avoidance of finite high-cost cells; coincident endpoints are rejected (HTTP 422) because they cannot form a non-degenerate engineering route."}, {"id": "docs_artifacts_python_engine_architecture_supercover_visibility", "label": "Supercover Visibility Check", "file_type": "rationale", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visibility uses a continuous grid-coordinate supercover that tests every raster cell a candidate segment touches, including both side cells at internal corners and boundaries, so a shortcut cannot slip diagonally through a blocked cell; the higher adjacent finite cost is used conservatively on boundaries."}, {"id": "docs_artifacts_python_engine_architecture_py_013", "label": "SURGE-PY-013 Electrical Feasibility Validation", "file_type": "concept", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fast deterministic screening proxy: structural inconsistencies raise ValueError because the electrical result would be undefined, while well-formed networks exceeding limits return AMPACITY_EXCEEDED / VOLTAGE_LIMIT_EXCEEDED / SUBSTATION_CAPACITY_EXCEEDED records rather than exceptions."}, {"id": "docs_artifacts_python_engine_architecture_screening_proxy_not_pandapower", "label": "Screening Proxy Is Not Load-Flow Approval", "file_type": "rationale", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The linear voltage-drop screen ignores conductor losses in downstream power, shunt admittance, transformers, tap changers, imbalance, fault levels and derating, so its results are preliminary and must not be presented as final electrical design approval."}, {"id": "docs_artifacts_python_engine_architecture_py_034", "label": "PY-034 Land Parcel and Landowner Decision Intelligence", "file_type": "concept", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Land policy is burned into the prepared cost surface before scenario generation: UNAVAILABLE parcels become hard exclusions and profiled parcels take an additive owner-interaction and present-value penalty, while layer IDs stay unique so ROW extraction still reports original parcel identity."}, {"id": "docs_artifacts_python_engine_architecture_java_feeder_segment_persistence", "label": "Deferred Java-Level Feeder Aggregation", "file_type": "rationale", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Java persists each returned route feature as a distinct route record, so one feeder appears as several feeder-summary segment rows downstream; these records represent feeder segments and the deferral of Java-side aggregation is intentional rather than a defect."}, {"id": "docs_artifacts_python_engine_architecture_py_011_row_analysis", "label": "SURGE-PY-011 ROW Corridor and Constraint Analysis", "file_type": "concept", "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Route CRS is supplied separately from corridor configuration because Shapely geometries carry no CRS metadata; flat end caps stop the corridor at exact route endpoints, and both summed segment area and the unique union footprint are recorded because feeder segments overlap at substations and shared alignments."}], "edges": [{"source": "docs_artifacts_python_engine_architecture", "target": "docs_artifacts_surge_mvp_ticket_plan", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "See Surge MVP Ticket Plan for the authoritative boundaries", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture", "target": "docs_artifacts_presentation_boundary", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "See Python Presentation Boundary", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture", "target": "docs_artifacts_python_engine_architecture_optimisation_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "Pipeline", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_py_007", "target": "docs_artifacts_python_engine_architecture_cost_surface", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "SURGE-PY-007: Uniform Cost Surface", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_py_008", "target": "docs_artifacts_python_engine_architecture_cost_surface", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "A* physical routes over the projected cost surface", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_py_009", "target": "docs_artifacts_python_engine_architecture_cost_surface", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "visibility across the cost surface", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_py_009", "target": "docs_artifacts_python_engine_architecture_py_008", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "preventing refinement from undoing A* avoidance", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_supercover_visibility", "target": "docs_artifacts_python_engine_architecture_py_009", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "SURGE-PY-009", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_py_008", "target": "docs_artifacts_python_engine_architecture_py_006", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "A* translation from topology edges to projected physical routes", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_screening_proxy_not_pandapower", "target": "docs_artifacts_python_engine_architecture_py_013", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "This is not pandapower validation", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_py_013", "target": "docs_artifacts_mvp_minimum_viable_product_py_015", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "fast deterministic screening proxy for a full nonlinear load flow", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_py_034", "target": "docs_artifacts_python_engine_architecture_cost_surface", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "burned into the prepared cost surface before scenario generation", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_java_feeder_segment_persistence", "target": "docs_artifacts_python_engine_architecture_optimisation_pipeline", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "Service and API Integration", "weight": 1.0}, {"source": "docs_artifacts_python_engine_architecture_py_011_row_analysis", "target": "docs_artifacts_mvp_minimum_viable_product_py_011", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/artifacts/Python Engine - Architecture.md", "source_location": "SURGE-PY-011 ROW Corridor and Constraint Analysis", "weight": 1.0}