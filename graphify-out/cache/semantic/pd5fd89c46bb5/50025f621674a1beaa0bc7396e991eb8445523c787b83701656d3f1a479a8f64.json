{"nodes": [{"id": "docs_artifacts_pnc_network_assembly", "label": "PNC Network Assembly", "file_type": "document", "source_file": "docs/artifacts/PNC Network Assembly.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_artifacts_pnc_network_assembly_pnc_package", "label": "app.pnc Orchestration Package", "file_type": "concept", "source_file": "docs/artifacts/PNC Network Assembly.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_artifacts_pnc_network_assembly_project_pnc_network", "label": "ProjectPNCNetwork", "file_type": "concept", "source_file": "docs/artifacts/PNC Network Assembly.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "optimisation_python_app_pnc_assembly_build_pnc_network", "label": "build_pnc_network", "file_type": "code", "source_file": "docs/artifacts/PNC Network Assembly.md", "source_location": "optimisation-python/app/pnc/assembly.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "optimisation_python_app_pnc_geojson_network_to_feature_collection", "label": "network_to_feature_collection", "file_type": "code", "source_file": "docs/artifacts/PNC Network Assembly.md", "source_location": "optimisation-python/app/pnc/geojson.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_artifacts_pnc_network_assembly_deterministic_id_scheme", "label": "Deterministic Feeder and Segment ID Scheme", "file_type": "rationale", "source_file": "docs/artifacts/PNC Network Assembly.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feeder IDs (FDR-{N:03d}) and segment IDs (SEG-{feeder_suffix}-{N:04d}) are generated so that identical inputs always produce identical IDs and ordering, which makes assembly output reproducible and testable (determinism is an explicit test case)."}, {"id": "docs_artifacts_pnc_network_assembly_failure_model", "label": "PNC Assembly Fail-Loud Failure Model", "file_type": "rationale", "source_file": "docs/artifacts/PNC Network Assembly.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PNCAssemblyError is raised for orphan WTGs, unrouted topology edges, duplicate assignments and broken connectivity rather than dropping them silently, because a partial network returned as a successful assembly would look credible while being engineering-invalid."}, {"id": "docs_artifacts_pnc_network_assembly_mst_graph_authoritative_topology", "label": "MST Graph as Authoritative Topology", "file_type": "rationale", "source_file": "docs/artifacts/PNC Network Assembly.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mst_graph on each PNCFeeder is authoritative and topology is never reconstructed from geometry; ordered_node_ids is only a deterministic BFS convenience, so geometric coincidence can never silently redefine electrical connectivity."}, {"id": "docs_artifacts_pnc_network_assembly_no_algorithm_duplication", "label": "Zero Algorithm Duplication in the Orchestrator", "file_type": "rationale", "source_file": "docs/artifacts/PNC Network Assembly.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The assembly layer only calls group_wtgs, build_feeder_mst, route_collector_topology and refine_routing_result from their existing modules, so algorithm behaviour has a single implementation and cannot drift between orchestrator and module."}], "edges": [{"source": "docs_artifacts_pnc_network_assembly", "target": "docs_artifacts_mvp_minimum_viable_product_py_014", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "