, "author": null, "contributor": null, "rationale": "Inputs, constraints, raw metrics, weights, algorithm choice and rejection reasons are all preserved so any result can be audited \u2014 designs must be justifiable to regulators, landowners and internal reviewers, which a black-box score cannot do."}, {"id": "docs_prd_minimum_cost", "label": "Minimum Cost Scenario", "file_type": "concept", "source_file": "docs/PRD.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_minimum_land_impact", "label": "Minimum Land Impact Scenario", "file_type": "concept", "source_file": "docs/PRD.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_minimum_environmental_impact", "label": "Minimum Environmental Impact Scenario", "file_type": "concept", "source_file": "docs/PRD.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_balanced", "label": "Balanced Scenario", "file_type": "concept", "source_file": "docs/PRD.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_determinism", "label": "Determinism Requirement", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "section 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical inputs and configuration must reproduce identical topology/scoring output (e.g. sorted edge selection), otherwise an audited design could not be re-derived later."}, {"id": "docs_prd_correctness_safety", "label": "Correctness and Safety Requirement", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "section 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard engineering constraints (feeder capacity, electrical limits, hard exclusions) must never be silently violated; invalid candidates are rejected outright rather than hidden or downweighted."}, {"id": "docs_prd_transparency_of_maturity", "label": "Transparency of Maturity", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "section 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capabilities must be labeled Implemented, Partial, or Planned at any point in time so users can tell real engineering output from scaffolding."}, {"id": "docs_prd_ml_ranking_experimental_labeling", "label": "ML Ranking Experimental Labeling", "file_type": "rationale", "source_file": "docs/PRD.md", "source_location": "section 7.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic scoring is the baseline and official result; an ML ranker may supplement it only once sufficient labeled data exists and its output is always labeled experimental unless explicitly promoted."}, {"id": "docs_prd_mvp_definition_of_done", "label": "MVP Definition of Done", "file_type": "concept", "source_file": "docs/PRD.md", "source_location": "section 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_target_lifecycle_coverage", "label": "Target Lifecycle Coverage", "file_type": "concept", "source_file": "docs/PRD.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_evaluation_axes", "label": "Five Evaluation Axes", "file_type": "concept", "source_file": "docs/PRD.md", "source_location": "section 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimisation quality, engineering feasibility, explainability, scalability and integrated usability \u2014 the MVP must provide measurable evidence on all five while marking structural design, foundations, statutory app