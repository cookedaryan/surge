{
  "$defs": {
    "InstalledSegment": {
      "additionalProperties": false,
      "properties": {
        "feeder_id": {
          "title": "Feeder Id",
          "type": "string"
        },
        "final_cable_type_id": {
          "title": "Final Cable Type Id",
          "type": "string"
        },
        "initial_cable_type_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Initial Cable Type Id"
        },
        "repaired": {
          "title": "Repaired",
          "type": "boolean"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "feeder_id",
        "initial_cable_type_id",
        "final_cable_type_id",
        "repaired"
      ],
      "title": "InstalledSegment",
      "type": "object"
    },
    "RepairActionRecord": {
      "additionalProperties": false,
      "properties": {
        "original_cable_type_id": {
          "title": "Original Cable Type Id",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "repair_iteration": {
          "minimum": 0,
          "title": "Repair Iteration",
          "type": "integer"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "trigger_violation_type": {
          "title": "Trigger Violation Type",
          "type": "string"
        },
        "upgraded_cable_type_id": {
          "title": "Upgraded Cable Type Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "original_cable_type_id",
        "upgraded_cable_type_id",
        "reason_code",
        "trigger_violation_type",
        "repair_iteration"
      ],
      "title": "RepairActionRecord",
      "type": "object"
    },
    "SizingBasis": {
      "description": "Whether published conductor sizing is the initial pass or what is installed.",
      "enum": [
        "INITIAL_ONLY",
        "FINAL_INSTALLED"
      ],
      "title": "SizingBasis",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "What was actually installed for the recommended design (WP1).",
  "properties": {
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_sizing_basis": {
      "$ref": "#/$defs/SizingBasis"
    },
    "repair_actions": {
      "items": {
        "$ref": "#/$defs/RepairActionRecord"
      },
      "title": "Repair Actions",
      "type": "array"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/InstalledSegment"
      },
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "candidate_sizing_basis",
    "segments",
    "repair_actions"
  ],
  "title": "DesignTruth",
  "type": "object"
}
