{"nodes": [{"id": "readme_surge_gis_optimisation_service", "label": "SURGE GIS Optimisation Service", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate FastAPI microservice isolates GIS processing, route optimisation, electrical analysis, ML inference and GeoJSON generation from the Java/frontend side of SURGE."}, {"id": "readme_mvp_baseline", "label": "API-Integrated MVP Baseline", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The integrated baseline deliberately returns a single refined routed network over a uniform prepared cost surface; richer PNC assembly, validation and packaging exist as standalone modules until orchestration and API integration land."}, {"id": "readme_route_refinement", "label": "Route Refinement", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw A* grid paths are jagged and carry redundant vertices, so refinement removes duplicate and collinear coordinates while preserving exact endpoints plus original/refined length and traversal-cost measurements so the refinement is auditable."}, {"id": "readme_visibility_shortcut_rule", "label": "Visibility Shortcut Acceptance Rule", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shortcut is accepted only when its raster supercover contains no blocked cell and its integrated cost does not exceed the subpath it replaces, so smoothing can never make a route illegal or more expensive."}, {"id": "readme_coincident_endpoint_rejection", "label": "Coincident Endpoint Rejection", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coincident endpoints are treated as spatially infeasible rather than degenerate-but-valid, because they cannot form a non-degenerate refined route."}, {"id": "readme_surge_py_014_pnc_assembly", "label": "SURGE-PY-014 PNC Network Assembly", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_surge_py_015_pandapower_validation", "label": "SURGE-PY-015 Pandapower Load Flow Validation", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_surge_py_016_presentation_packaging", "label": "SURGE-PY-016 Presentation Packaging", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_surge_py_017_candidate_pnc_generation", "label": "SURGE-PY-017 Deterministic Candidate PNC Generation", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_surge_py_018_scoring_recommendation", "label": "PY-018 Scoring and Recommendation", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_surge_py_019_orchestration", "label": "PY-019 Optimisation Orchestration", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_surge_py_020_api_integration", "label": "PY-020 Compatible API and End-to-End Integration", "file_type": "concept", "source_file": "README.md", "source_lo